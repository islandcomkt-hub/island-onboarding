{
  "name": "island-onboarding-archipelago",
  "version": "1.0.0",
  "private": true,
  "description": "Onboarding da Island Company: diagnóstico em seis etapas com arquipélago 3D (Three.js + GSAP)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build:e2e && playwright test",
    "verify": "npm run typecheck && npm run test && npm run build",
    "build:e2e": "cross-env NEXT_PUBLIC_ISLAND_DEBUG=1 next build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "cross-env": "^7.0.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
