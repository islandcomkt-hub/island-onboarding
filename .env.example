# ───────────────────────────────────────────────────────────────
# Island Onboarding — variáveis de ambiente (SEM segredos aqui)
# Copie para .env.local (dev) ou cadastre na Vercel (Project → Settings → Environment Variables)
# ───────────────────────────────────────────────────────────────

# Modo de entrega dos leads:
#   mock    = não grava nada (dev/preview). Em produção sem destino, a tela final pede o envio pelo WhatsApp
#   log     = grava cada lead (JSON) nos Function Logs da Vercel. Ponte rápida até existir base. Contém dados pessoais
#   d1      = grava direto no Cloudflare D1 (API HTTP). Exige as 3 variáveis CLOUDFLARE_* abaixo
#   webhook = envia para ISLAND_LEADS_WEBHOOK_URL (assinado com HMAC)
ISLAND_LEADS_MODE=mock

# Usadas somente quando ISLAND_LEADS_MODE=d1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=01866350-c663-4967-b003-7d1343288e46
# Token da API com SOMENTE a permissão "D1 Edit". Cadastre na Vercel como Sensitive; nunca no repositório.
CLOUDFLARE_API_TOKEN=

# Usado somente quando ISLAND_LEADS_MODE=webhook.
# Endpoint HTTPS que receberá o JSON do lead (contrato em docs/DADOS_E_INTEGRACOES.md)
ISLAND_LEADS_WEBHOOK_URL=
# Segredo para assinar o corpo (HMAC-SHA256, cabeçalho X-Island-Signature). Gere um valor longo e aleatório.
ISLAND_LEADS_WEBHOOK_SECRET=

# Permite o modo mock em produção (NÃO recomendado: nenhum lead é salvo)
ALLOW_MOCK_IN_PRODUCTION=false

# WhatsApp oficial (somente dígitos, com DDI). Valor documentado pela Island: (31) 98869-0118
NEXT_PUBLIC_WHATSAPP_NUMBER=5531988690118

# URL pública do deploy (metadados/OG). Opcional.
NEXT_PUBLIC_SITE_URL=

# Expõe window.__island (diagnóstico de animação) fora de desenvolvimento. Deixe vazio em produção.
NEXT_PUBLIC_ISLAND_DEBUG=
